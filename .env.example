# MyRnApp local development environment
# Generate machine-specific values: pnpm setup:env
# Or copy manually: cp .env.example .env

# Android SDK (required for pnpm android)
ANDROID_HOME=
ANDROID_SDK_ROOT=

# Java JDK 17+ (required for Gradle)
JAVA_HOME=

# Metro on physical device — your machine's LAN IP
REACT_NATIVE_PACKAGER_HOSTNAME=

# Web dev server & Bridge test (apps/mobile BridgeTestScreen)
WEB_DEV_PORT=3000
WEB_DEV_URL=http://localhost:3000
BRIDGE_TEST_WEB_URL=http://YOUR_LAN_IP:3000/bridge-test

# Android emulator (emulator -list-avds), optional
ANDROID_AVD=

# API_BASE_URL=http://localhost:3000/api
