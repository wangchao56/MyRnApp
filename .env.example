# MyRnApp local development environment
# Copy this file to `.env` and adjust only if your machine differs.

# Android SDK
ANDROID_HOME=E:\Android\Sdk
ANDROID_SDK_ROOT=E:\Android\Sdk

# Java (React Native Android builds require JDK 17 here)
JAVA_HOME=C:\Program Files\Java\jdk-17

# Optional: if Metro needs an explicit host for device debugging
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.100

# Optional: web/API development override if you later wire env loading
# API_BASE_URL=http://localhost:3000/api
