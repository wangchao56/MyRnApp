# MyRnApp - Environment Variables
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ---- Android ----
export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="$PATH:$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools"

# ---- Java (JDK 17 for React Native Android builds) ----
# Uncomment and adjust if auto-detection fails:
# export JAVA_HOME="/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home"

# ---- iOS ----
# No extra env vars needed if Xcode is installed from App Store

# ---- Development ----
# export REACT_NATIVE_PACKAGER_HOSTNAME="192.168.x.x"
