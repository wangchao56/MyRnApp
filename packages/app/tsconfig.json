{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@myapp/shared": ["../shared/src"],
      "@myapp/shared/*": ["../shared/src/*"]
    },
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "index.js"],
  "exclude": ["node_modules"]
}
