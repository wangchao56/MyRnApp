{
  "name": "@myapp/jsbridge",
  "version": "1.0.0",
  "description": "Multi-platform JSBridge library",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "build:esm": "tsc --module ES2020 --outDir dist/esm --declaration false",
    "build:cjs": "tsc --module commonjs --outDir dist/cjs --declaration false",
    "build:umd": "pnpm exec webpack --mode production --config webpack.config.js",
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:esm && pnpm run build:cjs && pnpm run build:umd",
    "dev": "pnpm exec webpack --mode development --config webpack.config.js --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm run build"
  },
  "keywords": [
    "jsbridge",
    "webview",
    "react-native"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@myapp/share": "workspace:*"
  }
}
