{
  "name": "my-rn-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "app": "pnpm --filter @myapp/app",
    "web": "pnpm --filter @myapp/web",
    "shared": "pnpm --filter @myapp/shared",
    "jsbridge": "pnpm --filter @myapp/jsbridge",
    "dev": "nx run-many -t dev --parallel",
    "dev:app": "nx run @myapp/app:dev",
    "dev:web": "nx run @myapp/web:dev",
    "dev:all": "nx run-many -t dev --parallel --projects=@myapp/app,@myapp/web",
    "dev:android": "concurrently \"pnpm dev:app\" \"react-native run-android --no-packager\"",
    "dev:app:web": "nx run @myapp/app:dev:web",
    "build": "nx run-many -t build",
    "build:jsbridge": "nx run @myapp/jsbridge:build",
    "build:web": "nx run @myapp/web:build",
    "build:app:web": "nx run @myapp/app:build:web",
    "build:app:android": "cd android && gradlew assembleRelease",
    "build:app:ios": "cd ios && xcodebuild -workspace MyRnApp.xcworkspace -scheme MyRnApp -configuration Release",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "clean": "nx run-many -t clean",
    "graph": "nx graph",
    "clean:cache": "node -e \"const fs=require('fs'),p=require('path'),d=['android/.gradle','android/app/build','android/build','node_modules/@react-native-async-storage/async-storage/android/.cxx','node_modules/react-native-safe-area-context/android/.cxx','node_modules/react-native-screens/android/.cxx','node_modules/react-native-vector-icons/android/.cxx','.gradle','.nx/cache'];d.forEach(dir=>{try{fs.rmSync(p.join(__dirname,dir),{recursive:true,force:true});console.log('✓ Cleared:',dir)}catch(e){console.log('⚠️  Failed to clear',dir,':',e.message)}});console.log('\\n✅ Cache cleaned successfully!')\"",
     "clean:metro": "node -e \"const fs=require('fs'),p=require('path'),os=require('os');fs.readdirSync(os.tmpdir()).filter(f=>f.startsWith('metro-file-map')).forEach(f=>{try{fs.rmSync(p.join(os.tmpdir(),f),{force:true});console.log('✓ Cleared:',f)}catch(e){}});console.log('Metro file-map cache cleared')\""
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-proposal-decorators": "^7.24.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.77.3",
    "@react-native/eslint-config": "0.77.3",
    "@react-native/gradle-plugin": "0.77.3",
    "@react-native/metro-config": "0.77.3",
    "@react-native/typescript-config": "0.77.3",
    "@rspack/cli": "1.3.0",
    "@rspack/core": "^1.3.0",
    "@types/react": "^18.2.6",
    "@types/react-dom": "^18.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-loader": "9.2.1",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "css-loader": "6.11.0",
    "eslint": "^9.0.0",
    "html-webpack-plugin": "5.6.7",
    "jest": "^29.7.0",
    "mobx": "^6.12.0",
    "mobx-react-lite": "^4.0.0",
    "mobx-state-tree": "^7.2.0",
    "nx": "^21.0.0",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "style-loader": "3.3.4",
    "ts-loader": "^9.5.0",
    "typescript": "5.0.4",
    "webpack": "5.107.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.2.4"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.0",
    "@react-native-vector-icons/material-icons": "^13.1.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "html5-qrcode": "^2.3.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.77.3",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "4.10.0",
    "react-native-swiper-flatlist": "^3.2.5",
    "react-native-web": "^0.19.0",
    "react-native-webview": "^13.16.1",
    "react-router-dom": "^6.22.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "overrides": {
      "webpack": "5.107.0",
      "webpack-cli": "5.1.4",
      "webpack-dev-server": "5.2.4"
    }
  },
  "volta": {
    "node": "22.22.3"
  }
}
