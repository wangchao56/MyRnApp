{
  "name": "my-rn-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "app": "pnpm --filter @myapp/app",
    "web": "pnpm --filter @myapp/web",
    "shared": "pnpm --filter @myapp/shared",
    "dev:app": "pnpm --filter @myapp/app start",
    "dev:web": "pnpm --filter @myapp/web dev",
    "dev:all": "concurrently \"pnpm dev:app\" \"pnpm dev:web\"",
    "build": "turbo run build",
    "build:web": "pnpm --filter @myapp/web build",
    "build:app:android": "pnpm --filter @myapp/app build:android",
    "build:app:ios": "pnpm --filter @myapp/app build:ios",
    "android": "pnpm --filter @myapp/app android",
    "ios": "pnpm --filter @myapp/app ios",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-proposal-decorators": "^7.24.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-async-storage/async-storage": "^1.23.0",
    "@react-native-community/cli-platform-android": "13.6.9",
    "@react-native/babel-preset": "0.74.89",
    "@react-native/eslint-config": "0.74.89",
    "@react-native/gradle-plugin": "0.74.89",
    "@react-native/metro-config": "0.74.89",
    "@react-native/typescript-config": "0.74.89",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "@types/react": "^18.2.6",
    "@types/react-dom": "^18.2.0",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-loader": "^9.1.0",
    "concurrently": "^8.2.0",
    "css-loader": "^6.10.0",
    "eslint": "^8.19.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "mobx": "^6.12.0",
    "mobx-react-lite": "^4.0.0",
    "mobx-state-tree": "^5.4.0",
    "prettier": "2.8.8",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.7",
    "react-native-safe-area-context": "^4.10.0",
    "react-native-screens": "^3.30.0",
    "react-native-web": "^0.19.0",
    "react-router-dom": "^6.22.0",
    "react-test-renderer": "18.2.0",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.5.0",
    "turbo": "^1.12.0",
    "typescript": "^5.0.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@8.15.0"
}
