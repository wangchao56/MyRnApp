{
  "name": "my-rn-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "app": "pnpm --filter @myapp/app",
    "web": "pnpm --filter @myapp/web",
    "shared": "pnpm --filter @myapp/shared",
    "dev": "turbo run dev --parallel --no-daemon",
    "dev:app": "pnpm --filter @myapp/app dev",
    "dev:web": "pnpm --filter @myapp/web dev",
    "dev:all": "pnpm dev",
    "dev:android": "concurrently \"pnpm dev:app\" \"pnpm android\"",
    "build": "turbo run build --no-daemon",
    "build:web": "pnpm --filter @myapp/web build",
    "build:app:android": "pnpm --filter @myapp/app build:android",
    "build:app:ios": "pnpm --filter @myapp/app build:ios",
    "android": "pnpm --filter @myapp/app android",
    "ios": "pnpm --filter @myapp/app ios",
    "lint": "turbo run lint --no-daemon",
    "test": "turbo run test --no-daemon",
    "typecheck": "turbo run typecheck --no-daemon",
    "clean": "turbo run clean --no-daemon"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-proposal-decorators": "^7.24.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/cli": "^13.0.0",
    "@react-native-community/cli-platform-android": "13.6.9",
    "@react-native-community/cli-platform-ios": "^13.0.0",
    "@react-native/babel-preset": "0.74.89",
    "@react-native/eslint-config": "0.74.89",
    "@react-native/metro-config": "0.74.89",
    "@react-native/typescript-config": "0.74.89",
    "@types/react": "^18.2.6",
    "@types/react-dom": "^18.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-loader": "^9.1.0",
    "concurrently": "^8.2.0",
    "css-loader": "^6.10.0",
    "eslint": "^9.0.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "mobx": "^6.12.0",
    "mobx-react-lite": "^4.0.0",
    "mobx-state-tree": "^7.2.0",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.5.0",
    "turbo": "^1.12.0",
    "typescript": "5.0.4",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^5.0.0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.0",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-vector-icons/material-icons": "^13.1.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo-linear-gradient": "^56.0.4",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.7",
    "react-native-safe-area-context": "^4.10.0",
    "react-native-screens": "^3.30.0",
    "react-native-web": "^0.19.0",
    "react-router-dom": "^6.22.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@8.15.0"
}
