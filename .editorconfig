# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# 单独配置脚本样式文件
[*.{js,ts,jsx,tsx,vue,css,scss,less}]
indent_size = 2

# 配置配置类文件
[*.{json,md,yml,yaml}]
indent_size = 2
