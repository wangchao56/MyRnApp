{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@myapp/shared": ["../../packages/shared/src"],
      "@myapp/shared/*": ["../../packages/shared/src/*"],
      "@myapp/share": ["../../packages/share/src"],
      "@myapp/share/*": ["../../packages/share/src/*"],
      "@myapp/nativeshare": ["../../packages/nativeshare/dist/index.d.ts"]
    },
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "index.js", "index.web.js"],
  "exclude": ["node_modules", "dist"]
}
