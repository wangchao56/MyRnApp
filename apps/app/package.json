{
  "name": "@myapp/app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "react-native start --no-interactive",
    "dev:web": "cross-env NODE_ENV=development rspack serve --config ../../rspack.config.js",
    "build:web": "cross-env NODE_ENV=production rspack build --config ../../rspack.config.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@myapp/shared": "workspace:*",
    "@myapp/jsbridge": "workspace:*"
  }
}
